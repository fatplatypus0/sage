{
  "name": "sage-euee-command-center",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "description": "SAGE \u2014 the 24-week EUEE Master Study Command Center (sleep-protected, Friday-afternoon-free).",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "lint:mobile": "node scripts/mobile-lint.mjs",
    "test:render": "esbuild tests/render.smoke.tsx --bundle --platform=node --format=cjs --outfile=.scratch/render-smoke.cjs --jsx=automatic --external:react --external:react-dom --log-level=warning && node .scratch/render-smoke.cjs",
    "check": "npm run typecheck && npm run lint:mobile && npm run test:render"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/space-grotesk": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}

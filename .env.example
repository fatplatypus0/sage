# Everything here is OPTIONAL. With no .env.local file the app is fully functional and
# stores progress in localStorage only — no account, no backend, no analytics.
#
# Copy to .env.local for the dev server, and set the same two values in Vercel → Settings →
# Environment Variables for production. Both are public (publishable) keys by design: the
# row-level security policies in supabase/schema.sql are what actually protect a user's data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY
